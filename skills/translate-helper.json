  "input": { "type": "object", "properties": { "text": { "type": "string", "description": "待翻译文本" }, "target": { "type": "string", "description": "目标语言" }, "style": { "type": "string", "enum": ["学术", "商务", "口语"], "description": "翻译风格" } }, "required": ["text"] },
  "output": { "type": "object", "properties": {} },
  "requiredTools": [],
  "keywords": ["翻译", "translate", "英文", "中文", "论文翻译", "商务翻译"]
