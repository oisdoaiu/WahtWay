# Copy this file to server/.env on the deployment server. Do not commit server/.env.

# Skill Hub HTTP port. Nginx should proxy to this port on the same server.
PORT=4000

# Persistent directory for users, authentication signing secret, and Skill data.
SKILL_HUB_DATA_DIR=/var/lib/wahtway-skill-hub

# Generate a long random value, for example: openssl rand -base64 48
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Comma-separated registration invite codes. Leave unset to disable registration.
SKILL_HUB_INVITE_CODES=replace-with-an-invite-code

# Optional content controls.
REQUIRE_SKILL_REVIEW=true
ALLOWED_SKILL_TOOLS=
